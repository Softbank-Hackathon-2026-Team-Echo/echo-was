# 로컬 개발용 값. compose.yaml 의 db 서비스(개발용 더미 계정 echo/echo)에 붙는다.
DATABASE_URL=postgresql+asyncpg://echo:echo@localhost:55432/echo
# DB 통합 테스트용. 이름이 _test 로 끝나야 하며, 테스트가 스키마를 지우고 다시 만든다.
TEST_DATABASE_URL=postgresql+asyncpg://echo:echo@localhost:55432/echo_test
LOG_LEVEL=INFO
# 환경 접속 확인(비밀값 조회 + 접속 확인 + 클러스터 정보) 전체 제한 시간(초).
ENVIRONMENT_CHECK_TIMEOUT_SECONDS=5.0
# simulated(기본): 고정 값 / real: 실제 클러스터 /version·노드 수
ENVIRONMENT_ADAPTER_MODE=simulated
# 환경 접속용 비밀값(secretRef = env:ECHO_SECRET_<조직 키>__<NAME>, 조직 키 = slug 대문자·`-`→`_`).
# 프로세스 환경변수로만 읽으므로 `uv run --env-file .env uvicorn app.main:app` 로 실행해야 들어간다.
# 실제 자격 증명은 커밋하지 않는다.
# ECHO_SECRET_TEAM_ECHO__AWS_SEOUL_KUBECONFIG=local-dummy-value

# --- 원터치 배포 (API 서버 3) ---
# 퍼블릭 주소 도메인. 대표 {서비스}-{무작위 8자}.{도메인}, 환경별은 환경 config ingressDomain 이 있으면
# {서비스}-{같은 8자}.{ingressDomain}, 없으면 {서비스}-{환경}-{같은 8자}.{도메인}.
PUBLIC_BASE_DOMAIN=apps.echo.test
# 실행기·헬스체커·소스 저장소 모드. real 이면 GitHub Actions 빌드 + 쿠버네티스 직접 반영(API 서버 3-2).
# real 은 GITHUB_APP_ID·GITHUB_APP_PRIVATE_KEY_REF, SOURCE_CLIENT_MODE=github, HEALTH_CHECKER_MODE=http 가 필요하다.
EXECUTOR_MODE=fake
HEALTH_CHECKER_MODE=fake
SOURCE_CLIENT_MODE=fake
# GitHub App (SOURCE_CLIENT_MODE=github 일 때). 개인키 값은 ECHO_SECRET_* 환경변수에만 두고 여기에는 참조만.
# 실제 App: Echoport Deploy (https://github.com/apps/echoport-deploy, 조직 소유, 11/2 생성).
# GITHUB_APP_ID=5574944
# GITHUB_APP_PRIVATE_KEY_REF=env:ECHO_SECRET_GITHUB_APP_PRIVATE_KEY
# GITHUB_APP_INSTALL_URL=https://github.com/apps/echoport-deploy/installations/new
# GITHUB_API_BASE_URL=https://api.github.com

# --- 실제 빌드·배포·내리기 실행기 (EXECUTOR_MODE=real, API 서버 3-2) ---
# 빌드 워크플로(workflow_dispatch). App 에 Actions 읽기·쓰기 권한 + 이 저장소 설치가 필요하다.
# BUILD_GITHUB_REPOSITORY=Softbank-Hackathon-2026-Team-Echo/echo-was
# BUILD_GITHUB_WORKFLOW=customer-build.yml
# BUILD_GITHUB_REF=main
# aws 환경 config.roleArn 이 비었을 때 넘겨받을 역할.
# EXECUTOR_AWS_ROLE_ARN=arn:aws:iam::706878591119:role/echo-dev-executor
# 이미지 정본(Artifact Registry) 접두=ECR 접두 (aws 환경만 바꾼다, 같은 digest).
# IMAGE_REGISTRY_MIRRORS=asia-northeast3-docker.pkg.dev/team-echo-final/echo=706878591119.dkr.ecr.ap-northeast-1.amazonaws.com/echo
# 온프레 앱 주소 DNS(Cloudflare, DNS 편집 권한만). 토큰 값은 ECHO_SECRET_* 에만.
# CLOUDFLARE_API_TOKEN_REF=env:ECHO_SECRET_CLOUDFLARE_DNS_TOKEN
# CLOUDFLARE_ZONE_ID=

# --- 데이터 확인 (DATA_SYNC_CHECKER_MODE=postgres, 인프라 7) ---
# 출발 PostgreSQL 의 pg_stat_replication 에서 도착 구독의 복제 지연을 읽는다. pg_monitor 권한 계정만.
# DATA_SYNC_CHECKER_MODE=fake
# DATA_SYNC_DATABASES=aws=<A NLB 주소>:5432/echo_sub_rev,gcp=echo-pg.echo-data.svc.cluster.local:5432/echo_sub
# DATA_SYNC_USER=echo_monitor
# DATA_SYNC_PASSWORD_REF=env:ECHO_SECRET_DATA_SYNC_PASSWORD
# DATA_SYNC_SSL_MODE=require
# ONPREM_PULL_CHECK_SECONDS=300
# ONPREM_PULL_MIN_REMAINING_SECONDS=1800
# DEPLOY_IMAGE_PULL_GRACE_SECONDS=30
# KUBE_REQUEST_TIMEOUT_SECONDS=15
# GOOGLE_METADATA_BASE_URL=http://metadata.google.internal

# --- GitHub 로그인 + 조직·역할 (API 서버 6) ---
# 넷(CLIENT_ID·CLIENT_SECRET_REF·REDIRECT_URI·FRONTEND_BASE_URL) 중 하나라도 비면 로그인·콜백만 503.
# client secret 값은 ECHO_SECRET_* 환경변수에만 두고 여기에는 참조만 적는다.
# GITHUB_APP_CLIENT_ID=Iv23lipNlpKaIxNuvR17
# GITHUB_APP_CLIENT_SECRET_REF=env:ECHO_SECRET_GITHUB_APP_CLIENT_SECRET
# GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback
# FRONTEND_BASE_URL=http://localhost:3000
# 쿠키로 인증한 쓰기 요청이 허용되는 Origin(쉼표 구분, 정확히 같아야 함). 비면 쓰기가 모두 403.
# FRONTEND_ALLOWED_ORIGINS=http://localhost:3000
# 로컬 http 에서는 false. 배포(https)에서는 기본값 true 그대로.
# SESSION_COOKIE_SECURE=false
# 설정하면 이 GitHub 조직의 active 멤버만 로그인(App 이 그 조직에 설치 + Members 읽기 권한 필요).
# LOGIN_ALLOWED_GITHUB_ORG=softbank-hackathon-2026-team-echo
# RESERVED_ORG_SLUGS=team-echo
# AGENT_TOKEN_DEFAULT_DAYS=30
# AGENT_TOKEN_MAX_DAYS=90

# --- 데모 배포 주소 (11/2 확정, 도메인 echoport.uk) ---
# 배포 환경에서는 아래 값으로 둔다. 로컬 개발은 위 apps.echo.test·localhost 값 그대로.
# 고객 앱은 도메인 바로 아래 한 단계(shop-a1b2c3d4.echoport.uk)라 DNS·인증서는 *.echoport.uk 하나다.
# PUBLIC_BASE_DOMAIN=echoport.uk
# FRONTEND_BASE_URL=https://app.echoport.uk
# FRONTEND_ALLOWED_ORIGINS=https://app.echoport.uk
# GITHUB_OAUTH_REDIRECT_URI=https://api.echoport.uk/api/v1/auth/github/callback
# 고객 앱이 같은 등록 도메인 아래에 있으므로 고객 앱이 Domain 쿠키로 덮어쓰지 못하는 __Host- 이름을 쓴다
# (__Host- 쿠키는 Secure·Path=/·Domain 없음일 때만 저장된다. SESSION_COOKIE_SECURE 는 기본값 true 그대로).
# SESSION_COOKIE_NAME=__Host-echo_session
# 단계별 제한 시간(초)과 헬스체크 재확인 간격.
BUILD_TIMEOUT_SECONDS=900
DEPLOY_TIMEOUT_SECONDS=300
TEARDOWN_TIMEOUT_SECONDS=300
HEALTH_CHECK_INTERVAL_SECONDS=5
# 가짜 실행기가 한 작업을 끝내는 시간(초).
FAKE_EXECUTOR_STEP_SECONDS=2.0
# 일꾼(python -m app.worker).
WORKER_POLL_INTERVAL_SECONDS=1.0
WORKER_LEASE_SECONDS=30
WORKER_CONCURRENCY=1

# --- 이전 계획(API 서버 8·8-1) ---
# 비율 단계는 도착이 요청 N건을 5xx 허용 안에서 처리했는지 센다.
# 비율 10·50·100% 단계의 필요 건수(쉼표 구분 3개, 각 1~10000). 계획마다 requiredRequests 로 바꿀 수 있다.
# MIGRATION_REQUIRED_REQUESTS_DEFAULT=20,50,50
# 비율 단계마다 건수를 기다리는 최대 시간(초, 5~300). 계획마다 maxWaitSeconds 로 바꿀 수 있다.
# MIGRATION_MAX_WAIT_SECONDS_DEFAULT=30
# 예상 rps(1~10000). 예상 시간·가짜 카운터·simulate 에 쓴다(합성 트래픽 기준).
# MIGRATION_EXPECTED_RPS=50
# 카운터 읽기 주기(초, 1~10).
# MIGRATION_COUNT_POLL_SECONDS=1
# 최대 대기 끝에 도착의 마지막 성공 읽기가 이보다 오래되면 판단 불가로 롤백(초, 1~60).
# MIGRATION_COUNTS_STALE_SECONDS=5
# p95 참고 값을 읽는 창(초, 5~300). p95 는 판정에 쓰지 않는다.
# MIGRATION_P95_REFERENCE_WINDOW_SECONDS=30
# 단계 예상 시간에 더하는 여유(초, 0~60).
# 예상 = 여유 + (비율 단계면 min(최대 대기, ceil(필요 건수 ÷ (rps × 비율)))). 기본값이면 계획 17초.
# MIGRATION_STEP_OVERHEAD_SECONDS=2
# 승인 대기 만료(초). 지나면 승인·거절·취소·새 계획 만들기 때 EXPIRED 로 끝난다.
# MIGRATION_PLAN_APPROVAL_TTL_SECONDS=86400
# 롤백(출발 100%) 비율 적용 최대 시도 횟수. 다 실패하면 계획은 FAILED(rollbackStatus=FAILED).
# MIGRATION_ROLLBACK_MAX_ATTEMPTS=3
